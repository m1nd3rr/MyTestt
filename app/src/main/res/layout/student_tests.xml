<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
   >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bachground_profile"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Назад"
                android:onClick="onBackB"
                android:src="@drawable/back" />

            <TextView
                android:gravity="center"
                android:id="@+id/testName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/buttonBack"
                android:text="Владос Красава"
                android:textColor="#EDEDED"
                android:textSize="25sp" />
        </LinearLayout>

        <Button
            android:layout_marginHorizontal="20dp"
            android:onClick="questionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#74A6E7"
            android:text="Показать список вопросов"
            android:textColor="@color/white" />

        <TextView
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="19dp"
            android:text="Автор"
            android:textColor="#000"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/shape_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/profile_image_teacher"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:onClick="onClickOpenGallery"
                android:src="@drawable/student" />

            <TextView
                android:id="@+id/authorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="19dp"
                android:text="Владислав"
                android:textColor="#000"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:layout_marginStart="19dp"
            android:text="Другие тесты автора"
            android:textColor="#000"
            android:textSize="20sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/shape_bg"
            android:id="@+id/horizontalRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="55"
            tools:listitem="@layout/item_tests" />

        <Button
            android:layout_gravity="center"
            android:onClick="report"
            android:id="@+id/reportTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#74A6E7"
            android:text="Оставить жалобу"
            android:textColor="@color/white"
            android:layout_marginHorizontal="10dp"
            />
    </LinearLayout>

    <Button
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="20dp"
        android:onClick="startPassing"
        android:id="@+id/startTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#4B729B"
        android:text="Пройти тест"
        android:textColor="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
